<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
@if (User.Identity.IsAuthenticated && (vaiTro == "BacSi" || vaiTro == "Admin"))
{
    <script>
        // Màu pastel chuyên nghiệp
        const pieColors = ['#4F8A8B', '#F9ED69'];
        const barColors = ['#6A89CC', '#F8C291'];

        // Pie Chart: Số lượng bệnh nhân và bác sĩ
        new Chart(document.getElementById('pieChart').getContext('2d'), {
            type: 'pie',
            data: {
                labels: ['Bệnh nhân', 'Bác sĩ'],
                datasets: [{
                    data: [@ViewBag.SoLuongBenhNhan, @ViewBag.SoLuongBacSi],
                    backgroundColor: pieColors,
                    borderColor: '#fff',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: false,
                plugins: {
                    legend: { position: 'bottom', labels: { color: '#333', font: { size: 13, weight: 'bold' } } }
                },
                layout: { padding: 0 }
            }
        });

        // Bar Chart: Số lượng bệnh nhân đã đánh giá lâm sàng & xét nghiệm
        const maxY = Math.max(@ViewBag.SoUserKiemTraLamSang, @ViewBag.SoUserKiemTraXetNghiem) + 1;
        new Chart(document.getElementById('barChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels: ['Đã đánh giá lâm sàng', 'Đã đánh giá xét nghiệm'],
                datasets: [{
                    label: 'Số lượng bệnh nhân',
                    data: [
        @ViewBag.SoUserKiemTraLamSang,
        @ViewBag.SoUserKiemTraXetNghiem
                    ],
                    backgroundColor: barColors,
                    borderRadius: 8,
                    maxBarThickness: 36
                }]
            },
            options: {
                responsive: false,
                plugins: {
                    legend: { display: false },
                },
                layout: { padding: 0 },
                scales: {
                    x: {
                        ticks: { color: '#333', font: { size: 12 } },
                        grid: { display: false }
                    },
                    y: {
                        beginAtZero: true,
                        suggestedMax: maxY,
                        ticks: { color: '#333', font: { size: 12 }, stepSize: 1 },
                        grid: { color: '#eee' }
                    }
                }
            }
        });
    </script>
}
