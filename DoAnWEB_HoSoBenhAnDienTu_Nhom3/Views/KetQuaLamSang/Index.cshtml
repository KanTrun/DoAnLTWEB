@{
    ViewData["Title"] = "Kết quả lâm sàng";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-stethoscope text-primary"></i> Kết quả lâm sàng</h2>

                @* Chỉ Admin (Bác sĩ) mới thấy nút Thêm kết quả mới *@
                @if (User.IsInRole("Admin"))
                {
                    <a href="@Url.Action("Create")" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Thêm kết quả mới
                    </a>
                }
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Danh sách kết quả lâm sàng</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        Chức năng đang được phát triển. Sẽ hiển thị danh sách các kết quả khám lâm sàng của bệnh nhân.
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Ngày khám</th>
                                    <th>Bác sĩ</th>
                                    <th>Chẩn đoán</th>
                                    <th>Kết quả</th>
                                    @* Chỉ Admin mới thấy cột Thao tác *@
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <th>Thao tác</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="@(User.IsInRole("Admin") ? "5" : "4")" class="text-center text-muted">
                                        Chưa có dữ liệu
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
