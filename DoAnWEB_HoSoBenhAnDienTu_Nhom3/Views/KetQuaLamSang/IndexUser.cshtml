@model IEnumerable<DoAnWEB_HoSoBenhAnDienTu_Nhom3.Models.KetQuaLamSang>
@{
    ViewData["Title"] = "Kết quả lâm sàng của bạn";
    var stt = 1;
}

<div class="container my-4">
    <h3 class="mb-4 text-center text-primary">
        <i class="fas fa-file-medical-alt"></i> PHIẾU KẾT QUẢ LÂM SÀNG
    </h3>
    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="fas fa-info-circle"></i> Chưa có kết quả lâm sàng nào.
        </div>
    }
    else
    {
        foreach (var item in Model)
        {
            <div class="card mb-5 shadow custom-result-card">
                <div class="card-header bg-primary bg-gradient text-white d-flex justify-content-between align-items-center rounded-top">
                    <span class="fw-bold">Phiếu số: <span class="badge bg-light text-primary">@stt</span></span>
                    <span><i class="fas fa-calendar-alt"></i> Ngày khám: <b>@item.NgayKham.ToString("dd/MM/yyyy")</b></span>
                </div>
                <div class="card-body p-4">
                    <table class="table table-borderless table-hover custom-result-table mb-0">
                        <tbody>
                            <tr>
                                <td class="fw-semibold">Bác sĩ khám:</td>
                                <td>@item.BacSiKham</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">Nhiệt độ (°C):</td>
                                <td>@(item.NhietDo.HasValue ? item.NhietDo.Value.ToString("0.0") : "-")</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">Huyết áp:</td>
                                <td>@(string.IsNullOrEmpty(item.HuyetAp) ? "-" : item.HuyetAp)</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">Nhịp tim (bpm):</td>
                                <td>@(item.NhipTim.HasValue ? item.NhipTim.ToString() : "-")</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">Nhịp thở (lần/phút):</td>
                                <td>@(item.NhipTho.HasValue ? item.NhipTho.ToString() : "-")</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">Chẩn đoán:</td>
                                <td>@(string.IsNullOrEmpty(item.ChanDoan) ? "-" : item.ChanDoan)</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">Kết quả chi tiết:</td>
                                <td>@(string.IsNullOrEmpty(item.KetQua) ? "-" : item.KetQua)</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">Ghi chú:</td>
                                <td>@(string.IsNullOrEmpty(item.GhiChu) ? "-" : item.GhiChu)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer text-end text-muted small rounded-bottom">
                    <i class="fas fa-clock"></i> Ngày tạo phiếu: @item.NgayTao.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
            stt++;
        }
    }
</div>
