@model IEnumerable<DoAnWEB_HoSoBenhAnDienTu_Nhom3.ViewModels.BenhNhanSelectViewModel>

@{
    ViewData["Title"] = "Chọn bệnh nhân";
}

<style>
    /* Patient Selection Page Styling */
    .patient-selection-header {
        background: linear-gradient(135deg, #3498db 0%, #5dade2 100%);
        color: white;
        padding: 30px 0;
        margin-bottom: 30px;
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(52, 152, 219, 0.3);
    }

    .patient-selection-header h2 {
        margin: 0;
        font-weight: 700;
        font-size: 2rem;
        text-shadow: 1px 1px 3px rgba(0,0,0,0.2);
    }

    .patient-selection-header p {
        margin: 10px 0 0 0;
        opacity: 0.9;
        font-size: 1.1rem;
    }

    .patient-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        padding: 25px;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        border: 2px solid transparent;
        transition: all 0.3s ease;
    }

    .stat-card:hover {
        transform: translateY(-5px);
        border-color: #3498db;
        box-shadow: 0 8px 25px rgba(52, 152, 219, 0.2);
    }

    .stat-icon {
        font-size: 2.5rem;
        margin-bottom: 15px;
        color: #3498db;
    }

    .stat-number {
        font-size: 2rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 5px;
    }

    .stat-label {
        color: #7f8c8d;
        font-weight: 500;
    }

    .patient-table-container {
        background: white;
        border-radius: 15px;
        box-shadow: 0 8px 25px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .table-header {
        background: linear-gradient(135deg, #2980b9 0%, #3498db 100%);
        color: white;
        padding: 20px 25px;
        margin: 0;
    }

    .table-header h4 {
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .patient-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
    }

    .patient-table thead {
        background: #f8f9fa;
    }

    .patient-table th {
        padding: 20px 15px;
        font-weight: 600;
        color: #2c3e50;
        border-bottom: 2px solid #e9ecef;
        text-align: left;
        font-size: 0.95rem;
    }

    .patient-table tbody tr {
        transition: all 0.3s ease;
        border-bottom: 1px solid #f1f2f6;
    }

    .patient-table tbody tr:hover {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        transform: scale(1.01);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .patient-table td {
        padding: 20px 15px;
        vertical-align: middle;
        color: #2c3e50;
        font-weight: 500;
    }

    .patient-info {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .patient-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3498db, #5dade2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        font-size: 1.2rem;
    }

    .patient-details h6 {
        margin: 0 0 5px 0;
        color: #2c3e50;
        font-weight: 600;
    }

    .patient-details small {
        color: #7f8c8d;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .status-evaluated {
        background: #d4edda;
        color: #155724;
    }

    .status-pending {
        background: #fff3cd;
        color: #856404;
    }

    .action-buttons {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .action-btn {
        padding: 10px 15px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 100px;
        justify-content: center;
    }

    .btn-examine {
        background: linear-gradient(135deg, #27ae60, #2ecc71);
        color: white;
        border: none;
    }

    .btn-examine:hover {
        background: linear-gradient(135deg, #229954, #27ae60);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(39, 174, 96, 0.4);
        color: white;
    }

    .btn-evaluate {
        background: linear-gradient(135deg, #3498db, #5dade2);
        color: white;
        border: none;
    }

    .btn-evaluate:hover {
        background: linear-gradient(135deg, #2980b9, #3498db);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(52, 152, 219, 0.4);
        color: white;
    }

    .no-data-container {
        text-align: center;
        padding: 60px 30px;
        color: #7f8c8d;
    }

    .no-data-icon {
        font-size: 4rem;
        margin-bottom: 20px;
        color: #bdc3c7;
    }

    .no-data-title {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 10px;
        color: #2c3e50;
    }

    .no-data-message {
        font-size: 1.1rem;
        margin-bottom: 30px;
    }

    .search-filter-section {
        background: white;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        margin-bottom: 25px;
    }

    .search-box {
        position: relative;
        max-width: 400px;
    }

    .search-input {
        width: 100%;
        padding: 12px 45px 12px 15px;
        border: 2px solid #e9ecef;
        border-radius: 25px;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .search-input:focus {
        outline: none;
        border-color: #3498db;
        box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
    }

    .search-icon {
        position: absolute;
        right: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #7f8c8d;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .patient-selection-header {
            padding: 20px 15px;
            margin-bottom: 20px;
        }

        .patient-selection-header h2 {
            font-size: 1.5rem;
        }

        .patient-stats {
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .stat-card {
            padding: 20px 15px;
        }

        .patient-table-container {
            margin: 0 -15px;
            border-radius: 0;
        }

        .patient-table {
            font-size: 0.9rem;
        }

        .patient-table th,
        .patient-table td {
            padding: 15px 10px;
        }

        .action-buttons {
            flex-direction: column;
            gap: 8px;
        }

        .action-btn {
            min-width: auto;
            padding: 8px 12px;
            font-size: 0.8rem;
        }

        .patient-info {
            flex-direction: column;
            text-align: center;
            gap: 10px;
        }

        .patient-avatar {
            width: 40px;
            height: 40px;
            font-size: 1rem;
        }
    }

    @@media (max-width: 576px) {
        .patient-stats {
            grid-template-columns: 1fr;
        }

        .search-filter-section {
            padding: 20px 15px;
        }

        .search-box {
            max-width: 100%;
        }
    }
</style>

<div class="container-fluid my-4">
    <!-- Header Section -->
    <div class="patient-selection-header text-center">
        <div class="container">
            <h2>
                <i class="fas fa-users-medical me-3"></i>
                CHỌN BỆNH NHÂN
            </h2>
            <p>Chọn bệnh nhân để thực hiện đánh giá lâm sàng và nhập kết quả khám bệnh</p>
        </div>
    </div>

    <div class="container">
        <!-- Statistics Cards -->
        <div class="patient-stats">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-number">@(Model?.Count() ?? 0)</div>
                <div class="stat-label">Tổng bệnh nhân</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-user-check"></i>
                </div>
                <div class="stat-number">@(Model?.Count(x => x.NgayKhamGanNhat.HasValue) ?? 0)</div>
                <div class="stat-label">Đã đánh giá</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="fas fa-user-clock"></i>
                </div>
                <div class="stat-number">@(Model?.Count(x => !x.NgayKhamGanNhat.HasValue) ?? 0)</div>
                <div class="stat-label">Chưa đánh giá</div>
            </div>
        </div>

        <!-- Search and Filter Section -->
        <div class="search-filter-section">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="search-box">
                        <input type="text" class="search-input" id="searchPatient" placeholder="Tìm kiếm bệnh nhân...">
                        <i class="fas fa-search search-icon"></i>
                    </div>
                </div>
                <div class="col-md-6 text-md-end mt-3 mt-md-0">
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-primary active" id="showAll">
                            <i class="fas fa-list me-1"></i>Tất cả
                        </button>
                        <button type="button" class="btn btn-outline-success" id="showEvaluated">
                            <i class="fas fa-check me-1"></i>Đã đánh giá
                        </button>
                        <button type="button" class="btn btn-outline-warning" id="showPending">
                            <i class="fas fa-clock me-1"></i>Chưa đánh giá
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Patient Table -->
        <div class="patient-table-container">
            <div class="table-header">
                <h4>
                    <i class="fas fa-clipboard-list"></i>
                    Danh sách bệnh nhân
                </h4>
            </div>
            
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="patient-table">
                        <thead>
                            <tr>
                                <th>Thông tin bệnh nhân</th>
                                <th>Giới tính</th>
                                <th>Ngày sinh</th>
                                <th>Trạng thái</th>
                                <th>Đánh giá gần nhất</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody id="patientTableBody">
                            @foreach (var bn in Model)
                            {
                                <tr class="patient-row" 
                                    data-name="@bn.HoTen.ToLower()" 
                                    data-status="@(bn.NgayKhamGanNhat.HasValue ? "evaluated" : "pending")">
                                    <td>
                                        <div class="patient-info">
                                            <div class="patient-avatar">
                                                @bn.HoTen.Split(' ').LastOrDefault()?.Substring(0, 1).ToUpper()
                                            </div>
                                            <div class="patient-details">
                                                <h6>@bn.HoTen</h6>
                                                <small>Mã BN: @bn.MaBenhNhan</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <i class="fas @(bn.GioiTinh == "Nam" ? "fa-mars text-primary" : "fa-venus text-danger") me-2"></i>
                                        @bn.GioiTinh
                                    </td>
                                    <td>
                                        <i class="fas fa-birthday-cake text-warning me-2"></i>
                                        @bn.NgaySinh.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        @if (bn.NgayKhamGanNhat.HasValue)
                                        {
                                            <span class="status-badge status-evaluated">
                                                <i class="fas fa-check-circle me-1"></i>Đã đánh giá
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-pending">
                                                <i class="fas fa-clock me-1"></i>Chưa đánh giá
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (bn.NgayKhamGanNhat.HasValue)
                                        {
                                            <div>
                                                <i class="fas fa-calendar-check text-success me-2"></i>
                                                <strong>@bn.NgayKhamGanNhat.Value.ToString("dd/MM/yyyy")</strong>
                                                <br>
                                                <small class="text-muted">@bn.NgayKhamGanNhat.Value.ToString("HH:mm")</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                <i class="fas fa-minus-circle me-2"></i>
                                                Chưa có dữ liệu
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="action-buttons">
                                            <a href="@Url.Action("Create", "ThamKhamLamSang", new { maBenhNhan = bn.MaBenhNhan })"
                                               class="action-btn btn-examine"
                                               title="Thăm khám lâm sàng">
                                                <i class="fas fa-stethoscope"></i>
                                                Thăm khám
                                            </a>
                                            <a href="@Url.Action("Create", "KetQuaLamSang", new { maBenhNhan = bn.MaBenhNhan })"
                                               class="action-btn btn-evaluate"
                                               title="Đánh giá kết quả">
                                                <i class="fas fa-clipboard-check"></i>
                                                Đánh giá
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="no-data-container">
                    <div class="no-data-icon">
                        <i class="fas fa-user-slash"></i>
                    </div>
                    <h4 class="no-data-title">Không có bệnh nhân nào</h4>
                    <p class="no-data-message">
                        Hiện tại chưa có dữ liệu bệnh nhân trong hệ thống.<br>
                        Vui lòng kiểm tra lại hoặc liên hệ quản trị viên.
                    </p>
                    <a href="@Url.Action("Index", "QuanLyNguoiDung")" class="btn btn-primary">
                        <i class="fas fa-user-plus me-2"></i>
                        Quản lý người dùng
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div id="loadingOverlay" class="loading-overlay" style="display: none;">
    <div class="loading-spinner">
        <i class="fas fa-spinner fa-spin fa-3x text-primary"></i>
        <p class="mt-3">Đang tải dữ liệu...</p>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Search functionality
        const searchInput = document.getElementById('searchPatient');
        const patientRows = document.querySelectorAll('.patient-row');

        searchInput.addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase().trim();

            patientRows.forEach(row => {
                const patientName = row.getAttribute('data-name');
                if (patientName.includes(searchTerm)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });

            updateStats();
        });

        // Filter functionality
        const filterButtons = document.querySelectorAll('.btn-group button');

        filterButtons.forEach(button => {
            button.addEventListener('click', function() {
                // Remove active class from all buttons
                filterButtons.forEach(btn => btn.classList.remove('active'));
                // Add active class to clicked button
                this.classList.add('active');

                const filterId = this.id;

                patientRows.forEach(row => {
                    const status = row.getAttribute('data-status');

                    if (filterId === 'showAll') {
                        row.style.display = '';
                    } else if (filterId === 'showEvaluated' && status === 'evaluated') {
                        row.style.display = '';
                    } else if (filterId === 'showPending' && status === 'pending') {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });

                updateStats();
            });
        });

        // Update statistics
        function updateStats() {
            const visibleRows = document.querySelectorAll('.patient-row[style=""], .patient-row:not([style])');
            const evaluatedRows = Array.from(visibleRows).filter(row => row.getAttribute('data-status') === 'evaluated');
            const pendingRows = Array.from(visibleRows).filter(row => row.getAttribute('data-status') === 'pending');

            // Update stat numbers (if you want real-time updates)
            // This is optional - you might want to keep original numbers
        }

        // Loading animation for action buttons
        const actionButtons = document.querySelectorAll('.action-btn');

        actionButtons.forEach(button => {
            button.addEventListener('click', function(e) {
                // Show loading overlay
                document.getElementById('loadingOverlay').style.display = 'flex';

                // Add loading state to button
                const originalContent = this.innerHTML;
                this.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang tải...';
                this.style.pointerEvents = 'none';

                // Restore button after a short delay (in case of quick navigation)
                setTimeout(() => {
                    this.innerHTML = originalContent;
                    this.style.pointerEvents = 'auto';
                }, 1000);
            });
        });

        // Smooth animations
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        });

        // Observe stat cards for animation
        document.querySelectorAll('.stat-card').forEach(card => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            card.style.transition = 'all 0.6s ease';
            observer.observe(card);
        });

        // Table row hover effects
        patientRows.forEach(row => {
            row.addEventListener('mouseenter', function() {
                this.style.transform = 'scale(1.02)';
            });

            row.addEventListener('mouseleave', function() {
                this.style.transform = 'scale(1)';
            });
        });

        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // Ctrl + F to focus search
            if (e.ctrlKey && e.key === 'f') {
                e.preventDefault();
                searchInput.focus();
            }

            // Escape to clear search
            if (e.key === 'Escape' && document.activeElement === searchInput) {
                searchInput.value = '';
                searchInput.dispatchEvent(new Event('input'));
            }
        });
    });
</script>

<!-- Additional CSS for loading overlay -->
<style>
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.9);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
        backdrop-filter: blur(5px);
    }

    .loading-spinner {
        text-align: center;
        color: #2c3e50;
    }

        .loading-spinner p {
            font-weight: 600;
            margin: 0;
        }

    /* Animation for stat cards */
    @@keyframes fadeInUp {
        from

    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .stat-card {
        animation: fadeInUp 0.6s ease forwards;
    }

        .stat-card:nth-child(1) {
            animation-delay: 0.1s;
        }

        .stat-card:nth-child(2) {
            animation-delay: 0.2s;
        }

        .stat-card:nth-child(3) {
            animation-delay: 0.3s;
        }

    /* Pulse effect for pending status */
    .status-pending {
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%

    {
        opacity: 1;
    }

    50% {
        opacity: 0.7;
    }

    100% {
        opacity: 1;
    }

    }

    /* Smooth transitions for all interactive elements */
    * {
        transition: all 0.3s ease;
    }
</style>

