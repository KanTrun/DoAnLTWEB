@model IEnumerable<DoAnWEB_HoSoBenhAnDienTu_Nhom3.ViewModels.BenhNhanSelectViewModel>

@{
    ViewData["Title"] = "Chọn bệnh nhân";
}

<div class="patient-selection-container">
    <h2 class="section-title">Chọn bệnh nhân để nhập kết quả lâm sàng</h2>

    <div class="table-responsive">
        <table class="patient-table">
            <thead>
                <tr>
                    <th>Họ tên</th>
                    <th>Giới tính</th>
                    <th>Ngày sinh</th>
                    <th>Đánh giá gần nhất</th>
                    <th>Thăm khám</th>
                    <th>Đánh giá</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var bn in Model)
                    {
                        <tr>
                            <td data-label="Họ tên:">@bn.HoTen</td>
                            <td data-label="Giới tính:">@bn.GioiTinh</td>
                            <td data-label="Ngày sinh:">@bn.NgaySinh.ToString("dd/MM/yyyy")</td>
                            <td data-label="Đánh giá gần nhất:">
                                @if (bn.NgayKhamGanNhat.HasValue)
                                {
                                    @bn.NgayKhamGanNhat.Value.ToString("dd/MM/yyyy HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">Chưa đánh giá</span>
                                }
                            </td>
                            <td class="action-cell">
                                <a href="@Url.Action("Create", "ThamKhamLamSang", new { maBenhNhan = bn.MaBenhNhan })" class="action-button btn btn-success">
                                    <i class="fas fa-stethoscope"></i> Xem
                                </a>
                            </td>
                            <td class="action-cell">
                                <a href="@Url.Action("Create", "KetQuaLamSang", new { maBenhNhan = bn.MaBenhNhan })" class="action-button btn btn-primary">
                                    <i class="fas fa-edit"></i> Xem
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="no-data-message">Không có dữ liệu bệnh nhân nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
