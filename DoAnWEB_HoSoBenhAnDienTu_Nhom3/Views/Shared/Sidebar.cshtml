@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="sidebar" id="sidebar">
        <!-- Header -->
        <div class="sidebar-header">
            <h4><i class="fas fa-hospital"></i> Hồ Sơ Bệnh Án</h4>
        </div>

        <!-- Menu -->
        <ul class="sidebar-menu">
            <!-- Trang chủ -->
            <li>
                <a href="@Url.Action("Index", "Home")"
                   class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                    <i class="fas fa-home"></i> Trang chủ
                </a>
            </li>

            <!-- Hồ sơ bệnh án -->
            <li class="has-submenu" id="medical-menu">
                <a href="javascript:void(0)" onclick="toggleSubmenu(this)">
                    <i class="fas fa-file-medical"></i> Hồ sơ bệnh án
                </a>

                <!-- Đánh giá hồ sơ - chỉ Admin -->
                @if (User.IsInRole("Admin"))
                {
                <li class="has-submenu @(ViewContext.RouteData.Values["Controller"]?.ToString() == "HoSoBenhAn" ? "open" : "")">
                    <a href="javascript:void(0)" onclick="toggleSubmenu(this)">
                        <i class="fas fa-clipboard-check"></i> Đánh giá hồ sơ
                    </a>
                    <ul class="submenu @(ViewContext.RouteData.Values["Controller"]?.ToString() == "HoSoBenhAn" ? "open" : "")">
                        <li>
                            <a href="@Url.Action("Index", "HoSoBenhAn")"
                               class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "HoSoBenhAn" ? "active" : "")">
                                <i class="fas fa-users"></i> Hồ sơ bệnh nhân
                            </a>
                        </li>
                    </ul>
                </li>
                }
                <ul class="submenu" id="medical-submenu">
                    <li>
                        <a href="@Url.Action("Index", "KetQuaLamSang")"
                           class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "KetQuaLamSang" ? "active" : "")">
                            <i class="fas fa-stethoscope"></i> Kết quả lâm sàng
                        </a>
                    </li>
                    <li>
                        @if (User.IsInRole("Admin"))
                        {
                            <a href="@Url.Action("ChonBenhNhan", "KetQuaXetNghiem")"
                               class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "KetQuaXetNghiem" && ViewContext.RouteData.Values["Action"]?.ToString() == "ChonBenhNhan" ? "active" : "")">
                                <i class="fas fa-vial"></i> Kết quả xét nghiệm
                            </a>
                        }
                        else
                        {
                            <a href="@Url.Action("KetQuaCuaToi", "KetQuaXetNghiem")"
                               class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "KetQuaXetNghiem" && ViewContext.RouteData.Values["Action"]?.ToString() == "KetQuaCuaToi" ? "active" : "")">
                                <i class="fas fa-vial"></i> Kết quả xét nghiệm
                            </a>
                        }
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "DonDieuTri")"
                           class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "DonDieuTri" ? "active" : "")">
                            <i class="fas fa-prescription-bottle"></i> Đơn điều trị
                        </a>
                    </li>
                </ul>
            </li>


            <!-- Quản lý tài khoản -->
            @if (User.IsInRole("Admin"))
            {

                <li class="has-submenu" id="admin-account-menu">
                    <a href="javascript:void(0)" onclick="toggleSubmenu(this)">
                        <i class="fas fa-users-cog"></i> Quản lý hệ thống
                    </a>
                    <ul class="submenu" id="admin-account-submenu">
                        <li>
                            <a href="@Url.Action("Index", "QuanLyNguoiDung")"
                               class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "QuanLyNguoiDung" ? "active" : "")">
                                <i class="fas fa-users"></i> Quản lý người dùng
                            </a>
                        </li>
                        <li>
                            <a href="/Identity/Account/Manage/ChangePassword">
                                <i class="fas fa-key"></i> Đổi mật khẩu
                            </a>
                        </li>
                    </ul>
                </li>
            }
            else
            {
                <li class="has-submenu" id="user-account-menu">
                    <a href="javascript:void(0)" onclick="toggleSubmenu(this)">
                        <i class="fas fa-user-cog"></i> Tài khoản của tôi
                    </a>
                    <ul class="submenu" id="user-account-submenu">
                        <li>
                            <a href="@Url.Action("Index", "QuanLyNguoiDung")"
                               class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "QuanLyNguoiDung" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                                <i class="fas fa-user-edit"></i> Thông tin cá nhân
                            </a>
                        </li>
                        <li>
                            <a href="/Identity/Account/Manage/ChangePassword">
                                <i class="fas fa-key"></i> Đổi mật khẩu
                            </a>
                        </li>
                    </ul>
                </li>
            }

            <!-- Đăng xuất -->
            <li class="logout">
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post" style="margin: 0;">
                    <button type="submit" style="background: none; border: none; width: 100%; text-align: left; color: #dc3545; padding: 15px 20px; cursor: pointer;">
                        <i class="fas fa-sign-out-alt"></i> Đăng xuất
                    </button>
                </form>
            </li>
        </ul>
    </div>
}
