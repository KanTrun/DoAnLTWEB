@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hồ Sơ Bệnh Án Điện Tử</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DoAnWEB_HoSoBenhAnDienTu_Nhom3.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="~/css/landing.css" />
</head>
<body class="@(User.Identity.IsAuthenticated ? "logged-in" : "")">
    @if (SignInManager.IsSignedIn(User))
    {
        <!-- Sidebar -->
        <div class="sidebar" id="sidebar">
            <!-- Header -->
            <div class="sidebar-header">
                <h4><i class="fas fa-hospital"></i> Hồ Sơ Bệnh Án</h4>
            </div>

            <!-- Menu -->
            <ul class="sidebar-menu">
                <!-- Trang chủ -->
                <li>
                    <a href="@Url.Action("Index", "Home")"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="fas fa-home"></i> Trang chủ
                    </a>
                </li>

                <!-- Hồ sơ bệnh án - CẢ ADMIN VÀ USER ĐỀU THẤY -->
                <li class="has-submenu" id="medical-menu">
                    <a href="javascript:void(0)" onclick="toggleSubmenu(this)">
                        <i class="fas fa-file-medical"></i> Hồ sơ bệnh án
                    </a>
                    <ul class="submenu" id="medical-submenu">
                        <li>
                            <a href="@Url.Action("Index", "KetQuaLamSang")"
                               class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "KetQuaLamSang" ? "active" : "")">
                                <i class="fas fa-stethoscope"></i> Kết quả lâm sàng
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("Index", "KetQuaXetNghiem")"
                               class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "KetQuaXetNghiem" ? "active" : "")">
                                <i class="fas fa-vial"></i> Kết quả xét nghiệm
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("Index", "DonDieuTri")"
                               class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "DonDieuTri" ? "active" : "")">
                                <i class="fas fa-prescription-bottle"></i> Đơn điều trị
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- Phân quyền - CHỈ ADMIN MỚI THẤY -->
                @if (User.IsInRole("Admin"))
                {
                    <li>
                        <a href="@Url.Action("Index", "PhanQuyen")"
                           class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "PhanQuyen" ? "active" : "")">
                            <i class="fas fa-users-cog"></i> Phân quyền
                        </a>
                    </li>
                }

                <!-- Quản lý tài khoản - PHÂN BIỆT ADMIN VÀ USER -->
                @if (User.IsInRole("Admin"))
                {
                    <!-- Menu cho Admin -->
                    <li class="has-submenu" id="admin-account-menu">
                        <a href="javascript:void(0)" onclick="toggleSubmenu(this)">
                            <i class="fas fa-users-cog"></i> Quản lý hệ thống
                        </a>
                        <ul class="submenu" id="admin-account-submenu">
                            <li>
                                <a href="@Url.Action("Index", "QuanLyNguoiDung")"
                                   class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "QuanLyNguoiDung" ? "active" : "")">
                                    <i class="fas fa-users"></i> Quản lý người dùng
                                </a>
                            </li>
                            <li>
                                <a href="/Identity/Account/Manage/ChangePassword">
                                    <i class="fas fa-key"></i> Đổi mật khẩu
                                </a>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <!-- Menu cho User -->
                    <li class="has-submenu" id="user-account-menu">
                        <a href="javascript:void(0)" onclick="toggleSubmenu(this)">
                            <i class="fas fa-user-cog"></i> Tài khoản của tôi
                        </a>
                        <ul class="submenu" id="user-account-submenu">
                            <li>
                                <a href="@Url.Action("Index", "QuanLyNguoiDung")"
                                   class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "QuanLyNguoiDung" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                                    <i class="fas fa-user-edit"></i> Thông tin cá nhân
                                </a>
                            </li>
                            <li>
                                <a href="/Identity/Account/Manage/ChangePassword">
                                    <i class="fas fa-key"></i> Đổi mật khẩu
                                </a>
                            </li>
                        </ul>
                    </li>
                }

                <!-- Đăng xuất -->
                <li class="logout">
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" method="post" style="margin: 0;">
                        <button type="submit" style="background: none; border: none; width: 100%; text-align: left; color: #dc3545; padding: 15px 20px; cursor: pointer;">
                            <i class="fas fa-sign-out-alt"></i> Đăng xuất
                        </button>
                    </form>
                </li>
            </ul>
        </div>

        <!-- Mobile Toggle Button -->
        <button class="mobile-toggle" id="mobileToggle" onclick="toggleSidebar()">
            <i class="fas fa-bars"></i>
        </button>

        <!-- Main Content -->
        <div class="main-content" id="mainContent">
            <!-- Header với thông tin user -->
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h4 class="mb-0">@ViewData["Title"]</h4>
                                </div>
                                <div class="user-info">
                                    <span class="text-muted">Xin chào, </span>
                                    <strong>@User.Identity.Name</strong>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <span class="badge bg-danger ms-2">Bác sĩ</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary ms-2">Bệnh nhân</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Content -->
            <div class="content">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <!-- Layout cho trang đăng nhập -->
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    @if (SignInManager.IsSignedIn(User))
    {
        <script>
            // Sidebar toggle functions
            function toggleSidebar() {
                const sidebar = document.getElementById('sidebar');
                const mainContent = document.getElementById('mainContent');
                const mobileToggle = document.getElementById('mobileToggle');

                sidebar.classList.toggle('collapsed');
                mainContent.classList.toggle('expanded');

                // Lưu trạng thái sidebar
                localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
            }

            function toggleSubmenu(element) {
                const submenu = element.nextElementSibling;
                const parent = element.parentElement;

                // Đóng tất cả submenu khác
                document.querySelectorAll('.has-submenu').forEach(item => {
                    if (item !== parent) {
                        item.classList.remove('open');
                        const otherSubmenu = item.querySelector('.submenu');
                        if (otherSubmenu) {
                            otherSubmenu.style.maxHeight = '0';
                        }
                    }
                });

                // Toggle submenu hiện tại
                parent.classList.toggle('open');
                if (parent.classList.contains('open')) {
                    submenu.style.maxHeight = submenu.scrollHeight + 'px';
                } else {
                    submenu.style.maxHeight = '0';
                }
            }

            // Khôi phục trạng thái sidebar khi load trang
            document.addEventListener('DOMContentLoaded', function() {
                const sidebarCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
                if (sidebarCollapsed) {
                    document.getElementById('sidebar').classList.add('collapsed');
                    document.getElementById('mainContent').classList.add('expanded');
                }

                // Mở submenu chứa trang hiện tại
                const activeLink = document.querySelector('.sidebar-menu .active');
                if (activeLink) {
                    const parentSubmenu = activeLink.closest('.has-submenu');
                    if (parentSubmenu) {
                        parentSubmenu.classList.add('open');
                        const submenu = parentSubmenu.querySelector('.submenu');
                        if (submenu) {
                            submenu.style.maxHeight = submenu.scrollHeight + 'px';
                        }
                    }
                }
            });
        </script>
    }

    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
