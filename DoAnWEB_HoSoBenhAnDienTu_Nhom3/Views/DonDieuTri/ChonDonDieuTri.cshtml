@model DoAnWEB_HoSoBenhAnDienTu_Nhom3.Models.DonDieuTri
@{
    ViewData["Title"] = "Nhập đơn điều trị cho bệnh nhân";
}

<div class="container-fluid px-4 py-3">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-prescription-bottle-alt me-2"></i>
                        Nhập đơn điều trị cho bệnh nhân
                    </h4>
                </div>
                <div class="card-body">
                    <!-- SỬA: Đổi action từ LuuDonDieuTri thành ChonDonDieuTri -->
                    <form asp-action="ChonDonDieuTri" method="post">
                        <input type="hidden" asp-for="MaHoSo" />

                        <div class="mb-3">
                            <label asp-for="TenDonDieuTri" class="form-label">
                                <i class="fas fa-file-medical me-1"></i>
                                Tên đơn điều trị <span class="text-danger">*</span>
                            </label>
                            <input asp-for="TenDonDieuTri" class="form-control" placeholder="Nhập tên đơn điều trị">
                            <span asp-validation-for="TenDonDieuTri" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NgayBatDau" class="form-label">
                                <i class="fas fa-calendar-plus me-1"></i>
                                Ngày bắt đầu <span class="text-danger">*</span>
                            </label>
                            <input asp-for="NgayBatDau" type="datetime-local" class="form-control">
                            <span asp-validation-for="NgayBatDau" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NgayKetThuc" class="form-label">
                                <i class="fas fa-calendar-minus me-1"></i>
                                Ngày kết thúc
                            </label>
                            <input asp-for="NgayKetThuc" type="datetime-local" class="form-control">
                            <span asp-validation-for="NgayKetThuc" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-1"></i>
                                Quay lại
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-1"></i>
                                Lưu đơn điều trị
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
