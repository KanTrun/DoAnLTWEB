@model DoAnWEB_HoSoBenhAnDienTu_Nhom3.Models.ToaThuoc
@{
    ViewData["Title"] = "Toa thuốc chỉ định";
}

<div class="container mt-4">
    <h2 class="mb-4">
        <i class="fas fa-file-medical"></i> TOA THUỐC CHỈ ĐỊNH
    </h2>

    <form asp-action="ToaThuocChiDinh" method="post">
        <input type="hidden" asp-for="MaHoSo" />
        <input type="hidden" name="maBenhNhan" value="@ViewBag.MaBenhNhan" />

        <div class="mb-3">
            <label asp-for="NgayKeDon" class="form-label"></label>
            <input asp-for="NgayKeDon" type="datetime-local" class="form-control" />
        </div>

        <!-- Dropdown trạng thái -->

        <div class="mb-3">
            <label asp-for="TrangThai" class="form-label">Trạng thái *</label>
            <select asp-for="TrangThai" class="form-select">
                <option value="Cấp phát">Cấp phát</option>
                <option value="Chờ đợi xét nghiệm">Chờ đợi xét nghiệm</option>
                <option value="Chờ đợi lâm sàng">Chờ đợi lâm sàng</option>
                <option value="Đã kê">Đã kê</option>
            </select>
            <span asp-validation-for="TrangThai" class="text-danger"></span>
        </div>


        <div class="mb-3">
            <label asp-for="GhiChu" class="form-label"></label>
            <textarea asp-for="GhiChu" class="form-control" rows="3"></textarea>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
            <button type="submit" class="btn btn-success">
                <i class="fas fa-check"></i> Lưu toa thuốc
            </button>
        </div>
    </form>
</div>
