@model DoAnWEB_HoSoBenhAnDienTu_Nhom3.ViewModels.KeThuocViewModel
@{
    ViewData["Title"] = "Kê thuốc cho bệnh nhân";
}

<div class="container mt-4">
    <h2 class="mb-4">
        <i class="fas fa-prescription"></i> KÊ THUỐC CHO BỆNH NHÂN
    </h2>

    <form asp-action="KeThuoc" method="post">
        <input type="hidden" name="maBenhNhan" value="@ViewBag.MaBenhNhan" />
        <input type="hidden" name="maHoSo" value="@ViewBag.MaHoSo" />

        <!-- PHẦN 1: CHỌN THUỐC -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="fas fa-pills me-2"></i>
                    THÔNG TIN THUỐC
                </h5>
            </div>
            <div class="card-body">
                <!-- Tùy chọn: Thuốc mới hay có sẵn -->
                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="SuDungThuocMoi"
                               value="false" id="thuocCoSan" checked>
                        <label class="form-check-label" for="thuocCoSan">
                            Chọn thuốc có sẵn
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="SuDungThuocMoi"
                               value="true" id="thuocMoi">
                        <label class="form-check-label" for="thuocMoi">
                            Thêm thuốc mới
                        </label>
                    </div>
                </div>

                <!-- Chọn thuốc có sẵn -->
                <div id="thuocCoSanDiv">
                    <div class="mb-3">
                        <label for="MaThuocCoSan" class="form-label">Chọn thuốc</label>
                        <select name="MaThuocCoSan" class="form-select">
                            <option value="0">-- Chọn thuốc --</option>
                            @foreach (var thuoc in Model.DanhSachThuocCoSan)
                            {
                                <option value="@thuoc.MaThuoc">
                                    @thuoc.TenThuoc - @thuoc.HoatChat (@thuoc.DonVi)
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Form thêm thuốc mới -->
                <div id="thuocMoiDiv" style="display: none;">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="TenThuocMoi" class="form-label">Tên thuốc *</label>
                                <input asp-for="TenThuocMoi" class="form-control" />
                                <span asp-validation-for="TenThuocMoi" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="HoatChatMoi" class="form-label">Hoạt chất</label>
                                <input asp-for="HoatChatMoi" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="DonViMoi" class="form-label">Đơn vị</label>
                                <input asp-for="DonViMoi" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="GiaMoi" class="form-label">Giá</label>
                                <input asp-for="GiaMoi" type="number" step="0.01" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="SoLuongTonMoi" class="form-label">Số lượng tồn</label>
                                <input asp-for="SoLuongTonMoi" type="number" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="CongDungMoi" class="form-label">Công dụng</label>
                                <textarea asp-for="CongDungMoi" class="form-control" rows="3"></textarea>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="CachDungMoi" class="form-label">Cách dùng</label>
                                <textarea asp-for="CachDungMoi" class="form-control" rows="3"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HanSuDungMoi" class="form-label">Hạn sử dụng</label>
                        <input asp-for="HanSuDungMoi" type="date" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <!-- PHẦN 2: CHI TIẾT TOA THUỐC -->
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">
                    <i class="fas fa-file-medical me-2"></i>
                    CHI TIẾT TOA THUỐC
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="LieuLuong" class="form-label">Liều lượng *</label>
                            <input asp-for="LieuLuong" class="form-control"
                                   placeholder="VD: 500mg" />
                            <span asp-validation-for="LieuLuong" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="SoLanUong" class="form-label">Số lần uống *</label>
                            <input asp-for="SoLanUong" class="form-control"
                                   placeholder="VD: 3 lần/ngày" />
                            <span asp-validation-for="SoLanUong" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="SoLuong" class="form-label">Số lượng</label>
                            <input asp-for="SoLuong" type="number" class="form-control"
                                   placeholder="VD: 30 viên" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- NÚT THAO TÁC -->
        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Lưu kê thuốc
            </button>
        </div>
    </form>
</div>

<!-- JavaScript để ẩn/hiện form -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const thuocCoSanRadio = document.getElementById('thuocCoSan');
        const thuocMoiRadio = document.getElementById('thuocMoi');
        const thuocCoSanDiv = document.getElementById('thuocCoSanDiv');
        const thuocMoiDiv = document.getElementById('thuocMoiDiv');

        function toggleThuocForm() {
            if (thuocMoiRadio.checked) {
                thuocCoSanDiv.style.display = 'none';
                thuocMoiDiv.style.display = 'block';
            } else {
                thuocCoSanDiv.style.display = 'block';
                thuocMoiDiv.style.display = 'none';
            }
        }

        thuocCoSanRadio.addEventListener('change', toggleThuocForm);
        thuocMoiRadio.addEventListener('change', toggleThuocForm);

        // Khởi tạo trạng thái ban đầu
        toggleThuocForm();
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
