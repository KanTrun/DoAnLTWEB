@model DoAnWEB_HoSoBenhAnDienTu_Nhom3.ViewModels.ManageDoctorViewModel
@{
    ViewData["Title"] = "Thông tin Bác sĩ";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">
                        <i class="fas fa-user-md"></i>
                        @(Model.IsExisting ? "Cập nhật thông tin Bác sĩ" : "Nhập thông tin Bác sĩ")
                    </h4>
                </div>
                <div class="card-body">
                    @if (!Model.IsExisting)
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            Vui lòng nhập đầy đủ thông tin để sử dụng hệ thống.
                        </div>
                    }

                    <form asp-action="Doctor" method="post">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="HoTen" class="form-label"></label>
                                    <input asp-for="HoTen" class="form-control" placeholder="Nhập họ và tên" />
                                    <span asp-validation-for="HoTen" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="ChuyenKhoa" class="form-label"></label>
                                    <input asp-for="ChuyenKhoa" class="form-control" placeholder="Nhập chuyên khoa" />
                                    <span asp-validation-for="ChuyenKhoa" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="SoDienThoai" class="form-label"></label>
                                    <input asp-for="SoDienThoai" class="form-control" placeholder="Nhập số điện thoại" />
                                    <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Email" class="form-label"></label>
                                    <input asp-for="Email" class="form-control" placeholder="Nhập email" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group mb-3">
                            <label asp-for="MaKhoa" class="form-label"></label>
                            <select asp-for="MaKhoa" class="form-control" asp-items="Model.KhoaList">
                                <option value="">-- Chọn khoa --</option>
                            </select>
                            <span asp-validation-for="MaKhoa" class="text-danger"></span>
                        </div>
                        <div class="form-group text-center">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i>
                                @(Model.IsExisting ? "Cập nhật thông tin" : "Lưu thông tin")
                            </button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i>
                                Quay lại trang chủ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
