@model List<dynamic>
@{
    ViewData["Title"] = "Phân quyền người dùng";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-users-cog text-primary"></i> Phân quyền người dùng</h2>
            </div>

            <!-- Bộ lọc -->
            <div class="card mb-4">
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Lọc theo quyền:</label>
                            <select name="roleFilter" class="form-select" onchange="this.form.submit()">
                                <option value="">Tất cả</option>
                                <option value="Admin" selected="@(ViewBag.RoleFilter == "Admin" ? "selected" : null)">Admin (Bác sĩ)</option>
                                <option value="User" selected="@(ViewBag.RoleFilter == "User" ? "selected" : null)">User (Bệnh nhân)</option>
                            </select>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Danh sách người dùng -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Danh sách tài khoản (@Model.Count người dùng)</h5>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Email</th>
                                        <th>Quyền hệ thống</th>
                                        <th>Vai trò DB</th>
                                        <th>Trạng thái</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model)
                                    {
                                        <tr>
                                            <td>
                                                <i class="fas fa-envelope text-muted me-2"></i>
                                                @user.Email
                                            </td>
                                            <td>
                                                @if (user.Role == "Admin")
                                                {
                                                    <span class="badge bg-danger">
                                                        <i class="fas fa-user-md"></i> Admin (Bác sĩ)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary">
                                                        <i class="fas fa-user"></i> User (Bệnh nhân)
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(user.VaiTroDb))
                                                {
                                                    <span class="badge bg-info text-dark">@user.VaiTroDb</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Chưa có</span>
                                                }
                                            </td>
                                            <td>
                                                @if (user.LockoutEnd == null || user.LockoutEnd <= DateTime.Now)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-check-circle"></i> Hoạt động
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">
                                                        <i class="fas fa-ban"></i> Bị khóa
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <div class="action-group">
                                                    <!-- Dropdown thay đổi quyền -->
                                                    <form method="post" asp-action="ChangeRole" class="d-inline">
                                                        <input type="hidden" name="userId" value="@user.UserId" />
                                                        <select name="newRole" class="form-select form-select-sm d-inline w-auto" onchange="this.form.submit()">
                                                            <option value="Admin" selected="@(user.Role == "Admin" ? "selected" : null)">Admin (Bác sĩ)</option>
                                                            <option value="User" selected="@(user.Role == "User" ? "selected" : null)">User (Bệnh nhân)</option>

                                                        </select>
                                                        <noscript>
                                                            <button type="submit" class="btn btn-sm btn-primary">Đổi quyền</button>
                                                        </noscript>
                                                    </form>

                                                    <!-- Toggle trạng thái -->
                                                    <form method="post" asp-action="ToggleStatus" class="d-inline">
                                                        <input type="hidden" name="userId" value="@user.UserId" />
                                                        @if (user.LockoutEnd == null || user.LockoutEnd <= DateTime.Now)
                                                        {
                                                            <button type="submit" class="btn btn-outline-warning btn-sm"
                                                                    title="Khóa tài khoản"
                                                                    onclick="return confirm('Bạn có chắc muốn khóa tài khoản này?')">
                                                                <i class="fas fa-ban"></i> Khóa
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="submit" class="btn btn-outline-success btn-sm"
                                                                    title="Mở khóa tài khoản"
                                                                    onclick="return confirm('Bạn có chắc muốn mở khóa tài khoản này?')">
                                                                <i class="fas fa-check"></i> Mở khóa
                                                            </button>
                                                        }
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle"></i>
                            Không có người dùng nào phù hợp với bộ lọc.
                        </div>
                    }
                </div>
            </div>

            <!-- Thống kê -->
            <div class="row mt-4">
                <div class="col-md-6">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h5>Admin (Bác sĩ)</h5>
                                    <h3>@Model.Count(u => u.Role == "Admin")</h3>
                                </div>
                                <div class="align-self-center">
                                    <i class="fas fa-user-md fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h5>User (Bệnh nhân)</h5>
                                    <h3>@Model.Count(u => u.Role == "User")</h3>
                                </div>
                                <div class="align-self-center">
                                    <i class="fas fa-users fa-2x"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Hiển thị thông báo
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                toastr.success('@TempData["SuccessMessage"]');
            </text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                toastr.error('@TempData["ErrorMessage"]');
            </text>
        }
    </script>
}
